package env

import (
	"github.com/labstack/echo/v4"

	"github.com/jamestiberiuskirk/stackr/internal/service"
	"github.com/jamestiberiuskirk/stackr/internal/web/components"
	"github.com/jamestiberiuskirk/stackr/internal/web/components/form"
)

templ envPage(c echo.Context, view service.EnvView, loadErr error) {
	@components.Layout(c, "Env") {
		<main class="container">
			<header class="page-header">
				<div>
					<h1>Env</h1>
					<p class="text-muted">Live editing of <code>{ view.FilePath }</code></p>
				</div>
			</header>

			if loadErr != nil {
				<div class="alert alert-error">{ "Failed to load env: " + loadErr.Error() }</div>
			}

			<section class="panel">
				<header class="panel-header">
					<h2>.env file</h2>
				</header>
				if len(view.Entries) == 0 {
					<p class="text-muted">No variables yet — add one below.</p>
				} else {
					<table class="data-table">
						<thead>
							<tr><th>Key</th><th>Value</th><th></th></tr>
						</thead>
						<tbody>
							for _, e := range view.Entries {
								<tr>
									<td class="data-table-name"><code>{ e.Key }</code></td>
									<td><code>{ e.Value }</code></td>
									<td>
										<form method="POST" action={ templ.SafeURL("/env/" + e.Key + "/delete") } class="action-form">
											@form.CSRFField(c)
											<button type="submit" class="btn btn-secondary">Delete</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>

			<section class="panel">
				<header class="panel-header">
					<h2>Add or update</h2>
				</header>
				<form method="POST" action="/env" class="env-edit-form">
					@form.CSRFField(c)
					<div class="form-group">
						<label for="env-key">Key</label>
						<input type="text" id="env-key" name="key" placeholder="MY_VAR" required/>
					</div>
					<div class="form-group">
						<label for="env-value">Value</label>
						<input type="text" id="env-value" name="value" placeholder="anything"/>
					</div>
					<button type="submit" class="btn btn-primary">Save</button>
				</form>
			</section>

			if len(view.GlobalYAML) > 0 {
				<section class="panel">
					<header class="panel-header">
						<h2>env.global (from stackr.yaml)</h2>
					</header>
					<table class="data-table">
						<thead><tr><th>Key</th><th>Value</th></tr></thead>
						<tbody>
							for _, k := range view.SortedGlobalKeys() {
								<tr>
									<td class="data-table-name"><code>{ k }</code></td>
									<td><code>{ view.GlobalYAML[k] }</code></td>
								</tr>
							}
						</tbody>
					</table>
				</section>
			}

			if len(view.StackYAML) > 0 {
				<section class="panel">
					<header class="panel-header">
						<h2>env.stacks (from stackr.yaml)</h2>
					</header>
					for _, name := range view.SortedStackNames() {
						<h3 style="padding:1rem 1rem 0">{ name }</h3>
						<table class="data-table">
							<thead><tr><th>Key</th><th>Value</th></tr></thead>
							<tbody>
								for _, k := range stackKeys(view.StackYAML[name]) {
									<tr>
										<td class="data-table-name"><code>{ k }</code></td>
										<td><code>{ view.StackYAML[name][k] }</code></td>
									</tr>
								}
							</tbody>
						</table>
					}
				</section>
			}

			if len(view.Pools) > 0 {
				<section class="panel">
					<header class="panel-header">
						<h2>Auto-provisioned pool paths</h2>
					</header>
					<p class="text-muted" style="padding:0 1rem">
						stackr injects <code>STACKR_PROV_POOL_&lt;name&gt;</code> per stack
						pointing at <code>&lt;pool-base&gt;/&lt;stack&gt;</code>.
					</p>
					<table class="data-table">
						<thead><tr><th>Pool</th><th>Base path</th><th>Injected as</th></tr></thead>
						<tbody>
							for _, name := range view.SortedPoolNames() {
								<tr>
									<td class="data-table-name"><code>{ name }</code></td>
									<td><code>{ view.Pools[name] }</code></td>
									<td><code>{ "STACKR_PROV_POOL_" + name }</code></td>
								</tr>
							}
						</tbody>
					</table>
				</section>
			}
		</main>
	}
}

// stackKeys sorts the keys of a single stack's env map. Keeping this
// alongside the templ rather than on EnvView because it's used only here.
func stackKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	// Insertion sort — at homelab scale these maps have <20 entries; pulling
	// in sort just to call sort.Strings is fine, but inline is also fine
	// and keeps the templ self-contained. Use the stdlib version below.
	for i := 1; i < len(keys); i++ {
		for j := i; j > 0 && keys[j] < keys[j-1]; j-- {
			keys[j], keys[j-1] = keys[j-1], keys[j]
		}
	}
	return keys
}
