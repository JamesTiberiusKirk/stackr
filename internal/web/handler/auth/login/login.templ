package login

import (
	"github.com/labstack/echo/v4"
	"github.com/jamestiberiuskirk/stackr/internal/web/components"
	"github.com/jamestiberiuskirk/stackr/internal/web/components/form"
)

templ loginPage(c echo.Context, f LoginForm, errors map[string]string) {
	@components.Layout(c, "Log In") {
		<div class="container">
			<div class="auth-card">
				<h2 class="text-center">Log In</h2>
				@loginForm(c, f, errors)
			</div>
		</div>
	}
}

templ loginForm(c echo.Context, f LoginForm, errors map[string]string) {
	<form
		id="login-form"
		hx-post="/login"
		hx-swap="outerHTML"
		hx-target="#login-form"
		method="POST"
		action="/login"
	>
		@form.CSRFField(c)
		if form.GetError(errors, "general") != "" {
			<div class="alert alert-error">
				{ form.GetError(errors, "general") }
			</div>
		}
		<div class="form-group">
			<label for="email">Email</label>
			<input
				type="email"
				id="email"
				name="email"
				value={ f.Email }
				hx-post="/login/validate/email"
				hx-trigger="blur, input[this.closest('.form-group').querySelector('[data-has-error=true]')] delay:300ms"
				hx-swap="none"
			/>
			@form.FieldError("email", form.GetError(errors, "email"))
		</div>
		<div class="form-group">
			<label for="password">Password</label>
			<input
				type="password"
				id="password"
				name="password"
				hx-post="/login/validate/password"
				hx-trigger="blur, input[this.closest('.form-group').querySelector('[data-has-error=true]')] delay:300ms"
				hx-swap="none"
			/>
			@form.FieldError("password", form.GetError(errors, "password"))
		</div>
		<button type="submit" class="btn btn-primary" style="width:100%">Log In</button>
	</form>
}
