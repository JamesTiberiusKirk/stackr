# Site (hamr)
PORT=8080
DEV_MODE=true

# Base URL (set in production for cookie domain and CORS, leave empty for local dev)
# BASE_URL=https://example.com

# Database
DATABASE_PATH=./data/daemon.db

# Storage
STORAGE_PATH=./uploads

# Static assets base URL (override with CDN URL in production)
STATIC_BASE_URL=/static

# Stackr daemon
# STACKR_TOKEN is required — bearer token for the API.
# STACKR_REPO_ROOT points at the parent repo whose stacks the daemon manages.
# For local dev, sandbox/minimal ships a sample .stackr.yaml + nginx stack.
STACKR_TOKEN=dev-token-123
STACKR_REPO_ROOT=./sandbox/minimal
