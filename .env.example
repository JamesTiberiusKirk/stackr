# Site (hamr)
PORT=8080
DEV_MODE=true

# Base URL (set in production for cookie domain and CORS, leave empty for local dev)
# BASE_URL=https://example.com

# Database
DATABASE_PATH=./data/daemon.db

# Storage
STORAGE_PATH=./uploads

# Static assets base URL (override with CDN URL in production)
STATIC_BASE_URL=/static

# Stackr daemon
# STACKR_TOKEN is required — bearer token for the API.
# STACKR_REPO_ROOT points at the parent repo whose stacks the daemon manages.
# For local dev, sandbox/minimal ships a sample stackr.yaml + nginx stack.
# STACKR_CONFIG_FILE overrides the config filename — set to ".stackr.yaml"
# if you have a legacy repo that still ships the old hidden filename.
STACKR_TOKEN=dev-token-123
STACKR_REPO_ROOT=./sandbox/minimal

# First login: passwords aren't in config, set the admin password manually
# against your dev DB before the first browser login.
#
#   make sandbox-set-password
#   make sandbox-up                 # brings every declared stack up
#
# Then `hamr dev` and visit http://localhost:8080. See `make help` for the
# full sandbox target list.
